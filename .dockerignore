# Build context is the repo root (docker build -f deploy/Dockerfile .). Keep it small and secret-free.
.git
.github
.claude
docs
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
frontend/design-system/mock
deploy/*.md
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache
backend/projects/*
!backend/projects/README.txt
backend/installer
# State an ad-hoc run can leave inside the engine folder (saved sessions, screenshots, stores): never bake it in.
# The folder and recording names are anchored to backend/: unanchored (**/live, **/shots, **/*.jsonl) they also hid the
# React app's source (frontend/src/lib/live, frontend/src/components/live) and the test fixtures' recordings and
# pictures, so the image's npm build and its unit tests failed (tests/test_dockerignore.py guards this).
**/.agentqa
backend/auth
backend/runs
backend/reports
backend/visual
backend/live
backend/evidence
backend/shots
backend/*.jsonl
**/*.db
**/*.db-*
**/*.session.json
backend/.gitignore
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
desktop.ini
