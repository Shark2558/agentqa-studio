# One line-ending policy for every platform: LF in the repository and in working copies,
# except Windows batch files, which cmd.exe expects with CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.docx binary
*.xlsx binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
